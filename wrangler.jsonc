// Cloudflare Workers config: serve the files in ./public as a static site.
// No server code; Cloudflare serves index.html, style.css, etc. directly.
{
  "name": "depeiyu",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    // Unknown paths get public/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Serve only on the custom domain (depeiyu.com, added in the dashboard),
  // not on depeiyu.depeiyu.workers.dev.
  "workers_dev": false,
  // Preview links for non-main branches live on workers.dev, so they're off
  // too. Set both to true to get branch previews back.
  "preview_urls": false
}
